# Copy this file to a local .env to control the runtime configurtion of Klatsch for local testing
# and development.

# By default klatsch will bind to 0.0.0.0 in order to be reachable in production. A chat server
# which can only be reached from localhost does not make too much sense in most scenarios. For local
# development however it is often more secure to only bind to localhost and not open ports on the
# machine, especially in public networs and so on. So for local development we restrict ourselfs
# to 127.0.0.1 by default.
HOST=127.0.0.1

# 3000 is also the default port. We just make it explicit.
PORT=3000

# Can be set to ERROR, WARN, INFO, DEBUG and TRACE. INFO is the default. You can set separate log
# levels for individial targets. Special instructions override global ones. E.g. "warn,server=info".
LOG_LEVEL=INFO

# Whether klatsch remembers chat history between restarts. When set to false, all messages are lost
# on shutdown. Default is true.
PERSISTENCE=true

# Directory where klatsch stores its data. Only used when PERSISTENCE is true. Default is "data".
PERSISTENCE_DIRECTORY="data"

# How long a session stays valid without activity. Each request from the user extends their session
# by this interval. Accepts human readable durations like "30d", "12h" or "90m". Default is 3 days.
SESSION_IDLE_TIMEOUT=3d

# Hard cap on session lifetime. No amount of activity extends a session beyond this, counted from
# login. Users have to log in again afterwards. Accepts the same durations as SESSION_IDLE_TIMEOUT.
# Default is 30 days.
SESSION_MAX_LIFETIME=30d

# TLS (Transport Layer Security) mode. This controls if and how the server supports HTTPS for
# encrypted connections, as oppossed to plain HTTP. Valid modes are "static", "proxy" and "off".
# The values are case insensitive. Default is "off".
#
# "off": No encryption is used. There is no protection against a man-in-the-middle-attack. Use this
# for development setups or trusted local environments only. It is the default, because it is the
# only option able to work without additional configuration.
#
# "proxy": Klatsch will not use encryption itself. Yet, it will assume  TLS termination happens in a
# proxy (e.g. Caddy) which sits between Klatsch and the user using the UI. As oppossed to "off"
# Klatsch will indicate to the browser that it should only send the session cookies over trusted
# (i.e. encrypted) connection. Set this, if you are running a proxy and want to make it harder for
# attackers to steal session cookies.
#
# "static": TLS will terminate in Klatsch. Klatsch directly serves HTTPS and handles encryption
# itself. This configuration option requires "TLS_CERT_FILE" and "TLS_KEY_FILE" to be set.
TLS=off

# Required if TLS is static. The path to the TLS certificate file.
TLS_CERT_FILE="./data/klatsch.cert"

# Required if TLS is static. The path to the TLS private key file.
TLS_KEY_FILE="./data/klatsch.pem"
